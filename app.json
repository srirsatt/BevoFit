{
  "expo": {
    "name": "BevoFit",
    "slug": "gymScanner",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "bevofit",
    "ios": {
      "supportsTablet": false,
      "isTabletOnly": false,
      "bundleIdentifier": "com.sriram.bevofit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby UT Recreational Facilities and help you find the closest rec center.",
        "LSApplicationQueriesSchemes": [
          "maps",
          "comgooglemaps"
        ],
        "MinimumOSVersion": "17.0"
      },
      "splash": {
        "image": "./assets/splash-light.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sriram.bevofit"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "react-native-map-link",
      "expo-web-browser",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "9792995b-e864-4303-85f3-62d679471dcb"
      }
    },
    "owner": "nathos",
    "privacy": "public",
    "privacyPolicy": "https://srirsatt.github.io/BevoFit/privacy-policy.html"
  }
}