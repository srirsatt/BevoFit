{
  "expo": {
    "name": "BevoFit",
    "slug": "gymScanner",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "bevofit",
    "ios": {
      "supportsTablet": false,
      "isTabletOnly": false,
      "bundleIdentifier": "com.sriram.bevofit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby UT Recreational Facilities and help you find the closest rec center.",
        "LSApplicationQueriesSchemes": [
          "maps",
          "comgooglemaps"
        ]
      },
      "splash": {
        "image": "./assets/splash-light.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sriram.bevofit"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-asset",
      "react-native-map-link",
      "expo-web-browser",
      "expo-router",
      "expo-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BevoFit uses your location to find nearby recreational facilities.",
          "locationAlwaysAndWhenInUsePermission": "BevoFit uses your location in the background to notify you when you arrive near an open UT recreational facility.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9792995b-e864-4303-85f3-62d679471dcb"
      }
    },
    "owner": "nathos"
  }
}
